# WealthOS API.
#
# NOTE: Docker is not installed on the development machine, so this image is
# not built locally — Render builds it from this file. The first remote build
# is the real verification.
FROM python:3.12-slim AS base

# XGBoost links against OpenMP; libpq is needed by psycopg.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

# MALLOC_ARENA_MAX: glibc gives each thread its own malloc arena; capping
# them stops a threaded Python server fragmenting past a small memory limit.
# *_NUM_THREADS=1: the API's maths is small, every extra thread pool costs
# memory, and LightGBM + PyTorch OpenMP pools can deadlock.
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    MALLOC_ARENA_MAX=2 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /app

# CPU-only torch, installed FIRST and from PyTorch's own index.
#
# This line is load-bearing. On macOS `pip install torch==2.8.0` gives a CPU
# wheel, but on Linux x86_64 the same pin pulls the CUDA build and ~2.5 GB of
# nvidia-* dependencies that this service can never use. `==2.8.0` matches the
# local version 2.8.0+cpu, so requirements.txt below sees torch as satisfied.
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.8.0

# Dependencies next, so a code change does not reinstall the world.
COPY requirements.txt pyproject.toml ./
COPY packages ./packages
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir -e .

COPY backend ./backend
COPY ml ./ml
COPY data/reference ./data/reference
# Trained artifacts. Force-added to git (they are gitignored by pattern), so a
# clean clone still carries them; without them the API boots and reports
# available: false on the model panels.
COPY ml/models ./ml/models

# A non-root user, so a container escape does not land as root.
RUN useradd --create-home --uid 10001 wealthos && chown -R wealthos:wealthos /app
USER wealthos

ENV PYTHONPATH=/app PORT=8000
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT}/health" || exit 1

WORKDIR /app/backend
# Render overrides this with dockerCommand (which also runs migrations); this
# form is what `docker compose` and a bare `docker run` get.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
