# ---- Database ----
DATABASE_URL=postgresql+psycopg://localhost:5432/wealthos

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Wealth Copilot ----
# ---- AI chat and Autopilot explanations ----
# Set ONE of these keys for live answers. With neither, the chat falls back to
# a deterministic explainer that narrates the same backend tool outputs.
# LLM_PROVIDER: auto (Gemini if its key is set, else Claude) | gemini | anthropic | off
LLM_PROVIDER=auto
# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Anthropic key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5

# ---- Live market data and Upstox (see docs/real-data.md) ----
# Yahoo Finance (delayed quotes, daily history, news, calendar, commodities).
LIVE_MARKET_ENABLED=true
# Must equal the redirect URL registered on each user's Upstox developer app.
UPSTOX_REDIRECT_URI=http://localhost:8010/api/v1/brokers/upstox/callback
# Where the Upstox callback sends the browser afterwards.
FRONTEND_URL=http://localhost:3000
# The simulated broker from the account-linking phase: tests only.
BROKER_SANDBOX_ENABLED=false

# ---- Paths ----
KAGGLE_NSE_DIR=/Users/lakshoswal04/Downloads/Datasets
BIG_SHARKS_CSV=/Users/lakshoswal04/Downloads/Big_Sharks.csv

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
