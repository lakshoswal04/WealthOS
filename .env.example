# ---- Database ----
DATABASE_URL=postgresql+psycopg://localhost:5432/wealthos

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Wealth Copilot ----
# Optional. With no key the Copilot falls back to a deterministic explainer
# that narrates the same backend tool outputs, so the app still works.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5

# ---- Paths ----
KAGGLE_NSE_DIR=/Users/lakshoswal04/Downloads/Datasets
BIG_SHARKS_CSV=/Users/lakshoswal04/Downloads/Big_Sharks.csv

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
